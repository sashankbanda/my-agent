# MyAgent environment overrides (non-secret configuration only).
#
# Secrets (API keys, OAuth tokens) are NEVER configured here - they live in the
# Windows Credential Manager and are referenced by name from config/providers.yaml.
#
# Any setting in config/default.yaml can be overridden with an environment
# variable using the MYAGENT_ prefix and __ as the nesting separator.

# Override the data directory (default: %LOCALAPPDATA%/MyAgent)
#MYAGENT_APP__DATA_DIR=C:/somewhere/else

# Log level: DEBUG | INFO | WARNING | ERROR
#MYAGENT_LOGGING__LEVEL=INFO

# Server bind (localhost only by default; remote access arrives via Tailscale in M6)
#MYAGENT_SERVER__HOST=127.0.0.1
#MYAGENT_SERVER__PORT=8765
